<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ================================================================
    Akiba.Domain

    The innermost layer. It models what Akiba IS, not how it is stored
    or displayed.

    DEPENDENCY RULE: this project references NOTHING.
    No project references. No package references. Not EF Core, not
    MediatR, not ASP.NET Core, not Npgsql.

    This is enforced by Akiba.ArchitectureTests and by CI. If you find
    yourself wanting to add a reference here, the thing you are trying
    to do belongs in Akiba.Application or Akiba.Infrastructure.
    ================================================================
  -->

  <PropertyGroup>
    <RootNamespace>Akiba.Domain</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Some aggregate operations are internal because only another aggregate in this assembly
      may call them - Loan.CloseIntoRestructure, for instance, is driven by the restructuring
      service and must not be reachable from a Blazor component. The domain's own test project
      tests them directly rather than through a public wrapper that exists only for testing.

      This is an assembly attribute, not a package reference: Akiba.Domain still has none.
    -->
    <InternalsVisibleTo Include="Akiba.Domain.Tests" />
  </ItemGroup>

</Project>
