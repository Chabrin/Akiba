@page "/members"
@attribute [Authorize(Policy = AkibaPolicies.ViewsLedger)]
@inject IMediator Mediator
@inject IClock Clock
@inject NavigationManager Navigation

<PageTitle>Akiba - Members</PageTitle>

<PageHeader Title="Members"
            Description="Shareholding and borrowing limit, derived from each member's share account.">
    <Actions>
        <AsAtPicker AsAt="_asAt" AsAtChanged="OnAsAtChanged" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ml-3"
                   StartIcon="@Icons.Material.Filled.PersonAdd"
                   OnClick="@(() => _enrolling = true)">
            Enrol a member
        </MudButton>
    </Actions>
</PageHeader>

<EnrolMemberPanel @bind-Open="_enrolling" OnEnrolled="ReloadAsync" />
<MemberExitPanel @bind-Open="_exiting" Member="_exitingMember" OnRecorded="ReloadAsync" />

<MudPaper Elevation="1" Class="pa-2">
    <MudToolBar Dense="true" Class="akiba-no-print">
        <MudTextField T="string"
                      Value="_search"
                      ValueChanged="OnSearchChanged"
                      Placeholder="Search by name, membership number or payroll number"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      Clearable="true"
                      Class="mt-0" />

        <MudSpacer />

        <MudSwitch T="bool"
                   Value="_includeExited"
                   ValueChanged="OnIncludeExitedChanged"
                   Color="Color.Primary"
                   Label="Include members who have left CAL" />
    </MudToolBar>

    @if (_members is null)
    {
        <TableSkeleton Rows="10" Columns="5" />
    }
    else if (Filtered.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.Groups"
                    Title="@(_members.Count == 0 ? "No members yet" : "No member matches that")"
                    Description="@(_members.Count == 0
                        ? "A member is enrolled by the accounts clerk from their letter to the chairman, and becomes a member proper at their first share contribution."
                        : "Nothing in the register matches that search. Try a membership number, or part of a surname.")">
            @if (_members.Count == 0)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PersonAdd"
                           OnClick="@(() => _enrolling = true)">
                    Enrol the first member
                </MudButton>
            }
        </EmptyState>
    }
    else
    {
        <MudTable Items="Filtered"
                  Dense="true"
                  Hover="true"
                  Striped="true"
                  Elevation="0"
                  Breakpoint="Breakpoint.Sm"
                  OnRowClick="@((TableRowClickEventArgs<MemberSummary> row) => OpenStatement(row.Item))"
                  RowStyle="cursor: pointer">
            <HeaderContent>
                <MudTh>Member</MudTh>
                <MudTh>Membership no.</MudTh>
                <MudTh>Payroll no.</MudTh>
                <MudTh Style="text-align: right">Shareholding</MudTh>
                <MudTh Style="text-align: right">Borrowing limit</MudTh>
                <MudTh Style="text-align: center">Loans</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Member">
                    @context.Name
                    @if (!context.IsActive)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-2">
                            Left CAL
                        </MudChip>
                    }
                    @if (context.IsLandlord)
                    {
                        <MudTooltip Text="Deductions run on the landlord schedule, drawn on the main account">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ml-2">
                                Landlord
                            </MudChip>
                        </MudTooltip>
                    }
                </MudTd>
                <MudTd DataLabel="Membership no.">@context.MembershipNumber</MudTd>
                <MudTd DataLabel="Payroll no.">@context.PayrollNumber</MudTd>
                <MudTd DataLabel="Shareholding" Class="akiba-money-cell">
                    <MoneyText Amount="context.Shareholding" />
                </MudTd>
                <MudTd DataLabel="Borrowing limit" Class="akiba-money-cell">
                    <MoneyText Amount="context.BorrowingLimit" />
                </MudTd>
                <MudTd DataLabel="Loans" Style="text-align: center">
                    @if (context.RunningLoans >= 2)
                    {
                        <MudTooltip Text="A member may hold two loans and no more">
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">
                                @context.RunningLoans
                            </MudChip>
                        </MudTooltip>
                    }
                    else
                    {
                        @context.RunningLoans
                    }
                </MudTd>
                <MudTd Class="akiba-no-print">
                    @* Hidden until the pointer is on the row, so a register of two hundred
                       members reads as figures rather than as four hundred buttons - but
                       always present for the keyboard, which is how the office works. *@
                    @* The row itself opens the member's statement, so a click that lands on
                       one of these must not also do that. Reading a statement and recording
                       that somebody has left are not the same intention, and getting the
                       second when you asked for the first is alarming. *@
                    <div class="akiba-row-actions" @onclick:stopPropagation="true">
                        <MudTooltip Text="Statement">
                            <MudIconButton Icon="@Icons.Material.Filled.Description"
                                           Size="Size.Small"
                                           aria-label="@($"Statement for {context.Name}")"
                                           OnClick="@(() => OpenStatement(context))" />
                        </MudTooltip>

                        @if (context.IsActive)
                        {
                            <MudTooltip Text="Record that they have left CAL">
                                <MudIconButton Icon="@Icons.Material.Filled.Logout"
                                               Size="Size.Small"
                                               Color="Color.Warning"
                                               aria-label="@($"Record that {context.Name} has left")"
                                               OnClick="@(() => StartExit(context))" />
                            </MudTooltip>
                        }
                    </div>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager Class="akiba-no-print" />
            </PagerContent>
        </MudTable>

        <MudText Typo="Typo.caption" Class="mud-text-secondary pa-3 d-block">
            @Filtered.Count of @_members.Count member(s), stated as at
            @_asAt.ToString("d MMMM yyyy", CultureInfo.InvariantCulture). The borrowing limit is
            twice the shareholding; it is not the only constraint, since the two-thirds rule can
            bite well before it does.
        </MudText>
    }
</MudPaper>

@code {
    private DateOnly _asAt;
    private string _search = string.Empty;
    private bool _includeExited;
    private IReadOnlyList<MemberSummary>? _members;

    private bool _enrolling;
    private bool _exiting;
    private MemberSummary? _exitingMember;

    private IReadOnlyList<MemberSummary> Filtered =>
        _members is null
            ? []
            : string.IsNullOrWhiteSpace(_search)
                ? _members
                : [.. _members.Where(Matches)];

    protected override async Task OnInitializedAsync()
    {
        _asAt = Clock.TodayInNairobi;
        await LoadAsync();
    }

    private bool Matches(MemberSummary member) =>
        member.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || member.MembershipNumber.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || member.PayrollNumber.Contains(_search, StringComparison.OrdinalIgnoreCase);

    private void OnSearchChanged(string search) => _search = search ?? string.Empty;

    private async Task OnAsAtChanged(DateOnly asAt)
    {
        _asAt = asAt;
        _members = null;
        await LoadAsync();
    }

    private async Task OnIncludeExitedChanged(bool includeExited)
    {
        _includeExited = includeExited;
        _members = null;
        await LoadAsync();
    }

    private async Task LoadAsync() =>
        _members = await Mediator.Send(new ListMembersQuery(_asAt, _includeExited));

    private async Task ReloadAsync()
    {
        _members = null;

        await LoadAsync();
    }

    /// <summary>
    /// Opens the exit panel for one member.
    /// </summary>
    /// <remarks>
    /// The row click opens a statement, so this stops the click reaching it. Recording an exit
    /// and reading a statement are not the same intention and the wrong one is annoying in one
    /// direction and alarming in the other.
    /// </remarks>
    private void StartExit(MemberSummary member)
    {
        _exitingMember = member;
        _exiting = true;
    }

    private void OpenStatement(MemberSummary? member)
    {
        // MudTable hands back a nullable item; a click on a header or an empty row has none.
        if (member is null)
        {
            return;
        }


        Navigation.NavigateTo(
            $"/members/{member.MemberId.Value}?asAt={_asAt.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}");
    }
}
