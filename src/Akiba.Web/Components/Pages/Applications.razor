@page "/applications"
@attribute [Authorize(Policy = AkibaPolicies.ViewsLedger)]
@inject IMediator Mediator

<PageTitle>Akiba - Applications</PageTitle>

<PageHeader Title="Loan applications"
            Description="Entered from the signed paper form. Approval is by the zone and office representatives, so an application collects several decisions rather than one.">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Inbox"
                   OnClick="@(() => _step = LoanApplicationPanels.Step.Receive)">
            Receive an application
        </MudButton>
    </Actions>
</PageHeader>

<LoanApplicationPanels @bind-Current="_step" Application="_working" OnChanged="ReloadAsync" />

<MudPaper Elevation="1" Class="pa-2">
    <MudToolBar Dense="true" Class="akiba-list-toolbar akiba-no-print">
        <MudSelect T="LoanApplicationStatus?"
                   Value="_status"
                   ValueChanged="OnStatusChanged"
                   Label="Status"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Clearable="true"
                   Style="max-width: 18rem"
                   Class="mt-0 flex-shrink-0">
            <MudSelectItem T="LoanApplicationStatus?" Value="@(null)">All</MudSelectItem>
            @foreach (var status in Enum.GetValues<LoanApplicationStatus>())
            {
                <MudSelectItem T="LoanApplicationStatus?" Value="@status">@status</MudSelectItem>
            }
        </MudSelect>

        <MudSpacer />

        @* Clients are offered here and not on the members list, because a client is not a
           member - they hold no shares and borrow on different terms, but they do apply. *@
        <BorrowerFilter Value="_category" ValueChanged="OnCategoryChanged"
                        Total="@(_applications?.Count ?? 0)" Counts="CategoryCounts"
                        Categories="@AllCategories" />
    </MudToolBar>

    @if (_applications is null)
    {
        <TableSkeleton Rows="8" Columns="6" />
    }
    else if (Filtered.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.Assignment"
                    Title="No applications here"
                    Description="Nothing matches that filter. An application arrives as a
                                 paper form and is entered by the accounts clerk, so an empty
                                 list usually means the forms have not been keyed in yet.">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Inbox"
                       OnClick="@(() => _step = LoanApplicationPanels.Step.Receive)">
                Receive an application
            </MudButton>
        </EmptyState>
    }
    else
    {
        <MudTable Items="Filtered" Dense="true" Hover="true" Striped="true" Elevation="0"
                  Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Applicant</MudTh>
                <MudTh>Product</MudTh>
                <MudTh Style="text-align: right">Applied for</MudTh>
                <MudTh Style="text-align: right">Approved</MudTh>
                <MudTh>Received</MudTh>
                <MudTh>Considered</MudTh>
                <MudTh>Guarantors</MudTh>
                <MudTh>Status</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Applicant">
                    @context.BorrowerName
                    <BorrowerCategoryChip Category="context.BorrowerCategory" />
                </MudTd>
                <MudTd DataLabel="Product">@context.Product.DisplayName()</MudTd>
                <MudTd DataLabel="Applied for" Class="akiba-money-cell">
                    <MoneyText Amount="context.RequestedPrincipal" />
                </MudTd>
                <MudTd DataLabel="Approved" Class="akiba-money-cell">
                    @if (context.ApprovedPrincipal is { } approved)
                    {
                        <MoneyText Amount="approved" />
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">-</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Received">
                    @context.ReceivedOn.ToString("d MMM yyyy", CultureInfo.InvariantCulture)
                </MudTd>
                <MudTd DataLabel="Considered">
                    @context.ConsiderationMonth.ToString("MMMM yyyy", CultureInfo.InvariantCulture)
                    @if (context.MissedTheCutoff)
                    {
                        <MudTooltip Text="Received after the 15th, so it is considered in the succeeding month">
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-2">
                                Late
                            </MudChip>
                        </MudTooltip>
                    }
                </MudTd>
                <MudTd DataLabel="Guarantors">
                    @if (context.Guarantors == 0)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">None</MudText>
                    }
                    else
                    {
                        <MudTooltip Text="@($"{context.Guarantors} guarantor(s)")">
                            <MoneyText Amount="context.TotalGuaranteed" />
                        </MudTooltip>
                    }
                </MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Color="@StatusColour(context.Status)">
                        @context.Status
                    </MudChip>
                    @if (context.Status == LoanApplicationStatus.Submitted)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                            @context.DecisionsRecorded decision(s) recorded
                        </MudText>
                    }
                </MudTd>
                <MudTd Class="akiba-no-print">
                    @* The one action this application is ready for, and only that one. An
                       application waiting on representatives cannot be disbursed, and showing
                       the button anyway would be offering something that will be refused. *@
                    <div class="akiba-row-actions">
                        @switch (context.Status)
                        {
                            case LoanApplicationStatus.Draft:
                            case LoanApplicationStatus.Submitted:
                                <MudTooltip Text="Record a representative's decision">
                                    <MudIconButton Icon="@Icons.Material.Filled.HowToVote"
                                                   Size="Size.Small" Color="Color.Info"
                                                   aria-label="Record a decision"
                                                   OnClick="@(() => Start(context, LoanApplicationPanels.Step.Decide))" />
                                </MudTooltip>
                                <MudTooltip Text="Approve the application">
                                    <MudIconButton Icon="@Icons.Material.Filled.Gavel"
                                                   Size="Size.Small" Color="Color.Primary"
                                                   aria-label="Approve"
                                                   OnClick="@(() => Start(context, LoanApplicationPanels.Step.Approve))" />
                                </MudTooltip>
                                break;

                            case LoanApplicationStatus.Approved:
                                <MudTooltip Text="Record the cheque and start the loan">
                                    <MudIconButton Icon="@Icons.Material.Filled.RequestQuote"
                                                   Size="Size.Small" Color="Color.Warning"
                                                   aria-label="Disburse"
                                                   OnClick="@(() => Start(context, LoanApplicationPanels.Step.Disburse))" />
                                </MudTooltip>
                                break;
                        }
                    </div>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager Class="akiba-no-print" />
            </PagerContent>
        </MudTable>
    }
</MudPaper>

@code {
    private LoanApplicationStatus? _status;
    private IReadOnlyList<ApplicationSummary>? _applications;

    private BorrowerCategory? _category;

    private static readonly BorrowerCategory[] AllCategories =
        [BorrowerCategory.Employee, BorrowerCategory.Landlord, BorrowerCategory.Client];

    private IReadOnlyList<ApplicationSummary> Filtered =>
        _applications is null
            ? []
            : [.. _applications.Where(a => _category is null || a.BorrowerCategory == _category)];

    private IReadOnlyDictionary<BorrowerCategory, int> CategoryCounts =>
        _applications is null
            ? new Dictionary<BorrowerCategory, int>()
            : _applications
                .GroupBy(application => application.BorrowerCategory)
                .ToDictionary(group => group.Key, group => group.Count());

    private void OnCategoryChanged(BorrowerCategory? category) => _category = category;

    private LoanApplicationPanels.Step _step = LoanApplicationPanels.Step.None;
    private ApplicationSummary? _working;

    private void Start(ApplicationSummary application, LoanApplicationPanels.Step step)
    {
        _working = application;
        _step = step;
    }

    private async Task ReloadAsync()
    {
        _applications = null;

        await LoadAsync();
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private static Color StatusColour(LoanApplicationStatus status) => status switch
    {
        LoanApplicationStatus.Draft => Color.Default,
        LoanApplicationStatus.Submitted => Color.Info,
        LoanApplicationStatus.Approved => Color.Warning,
        LoanApplicationStatus.Disbursed => Color.Success,
        LoanApplicationStatus.Rejected => Color.Error,
        _ => Color.Default,
    };

    private async Task OnStatusChanged(LoanApplicationStatus? status)
    {
        _status = status;
        _applications = null;
        await LoadAsync();
    }

    private async Task LoadAsync() =>
        _applications = await Mediator.Send(new ListApplicationsQuery(_status));
}
