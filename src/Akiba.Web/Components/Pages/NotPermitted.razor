@page "/not-permitted"
@attribute [AllowAnonymous]

<PageTitle>Akiba - Not permitted</PageTitle>

<MudPaper Elevation="1" Class="pa-8" Style="max-width: 34rem; margin: 4rem auto;">
    <div class="d-flex align-center mb-4">
        <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Warning" Size="Size.Large" Class="mr-3" />
        <MudText Typo="Typo.h6">
            <h1 style="all: unset">Not permitted</h1>
        </MudText>
    </div>

    <MudText Typo="Typo.body2" Class="mb-4">
        Your role does not cover this screen. That is not a mistake in the system - Akiba gives
        each official exactly what their duties need and no more.
    </MudText>

    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
        Only the accounts clerk enters or changes figures. The treasurer, chairman and secretary
        see everything and each has their own approval. HR downloads the deduction schedules.
    </MudText>

    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary">
        Back to the dashboard
    </MudButton>
</MudPaper>
