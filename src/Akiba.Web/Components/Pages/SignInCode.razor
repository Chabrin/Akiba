@page "/sign-in/code"
@attribute [AllowAnonymous]
@layout SignInLayout

<PageTitle>Akiba - Authentication code</PageTitle>

<MudPaper Elevation="2" Class="pa-8" Style="max-width: 26rem; margin: 6rem auto;">
    <MudText Typo="Typo.h6" Class="mb-2">
        <h1 style="all: unset">Authentication code</h1>
    </MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-5">
        Enter the six-digit code from your authenticator app.
    </MudText>

    @if (Error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">
            That code was not accepted. Codes change every thirty seconds - wait for the next one
            and try again.
        </MudAlert>
    }

    <form method="post" action="/auth/code">
        <MudTextField T="string"
                      Label="Code"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      UserAttributes="@(new() { ["name"] = "code", ["inputmode"] = "numeric", ["autocomplete"] = "one-time-code", ["required"] = true, ["autofocus"] = true, ["maxlength"] = "7" })"
                      Class="mb-5" />

        <MudButton ButtonType="ButtonType.Submit"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Size="Size.Large">
            Continue
        </MudButton>
    </form>

    <MudLink Href="/sign-in" Typo="Typo.caption" Class="mt-5 d-block">
        Sign in as somebody else
    </MudLink>
</MudPaper>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }
}
