@page "/sign-in/code"
@attribute [AllowAnonymous]
@layout SignInLayout

<PageTitle>Akiba - Authentication code</PageTitle>

@* The same heading as the password step, so the two read as one sign-in in two parts
   rather than two different screens. *@
<div class="akiba-signin-content">
    <div class="akiba-signin-heading">
        <span class="akiba-signin-eyebrow">Step 2 of 2</span>
        <h1 class="akiba-signin-title">Verify your identity</h1>
    </div>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-6" id="akiba-otp-help">
        Enter the 6-digit code from your authenticator app.
    </MudText>

    @if (Error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">
            That code was not accepted. Codes change every thirty seconds - wait for the next one
            and try again.
        </MudAlert>
    }

    <form method="post" action="/auth/code" data-akiba-otp-form>
        @* Proves this post came from Akiba's own page. Without it another site could
           post here and sign an official into an account somebody else controls. *@
        <AntiforgeryToken />

        @* One real input, drawn as six boxes by js/akiba-otp.js.

           One input rather than six, so everything that already works on a code field keeps
           working: pasting a code, a phone offering the code from its authenticator, a password
           manager filling it, and a screen reader hearing one field called "Authentication
           code" instead of six unlabelled boxes. The boxes are decoration over it.

           Without the script this is simply a text field, and the Continue button posts it. *@
        <div class="akiba-otp" data-akiba-otp>
            <label for="akiba-otp-input" class="akiba-visually-hidden">Authentication code</label>
            <input id="akiba-otp-input"
                   class="akiba-otp-input"
                   name="code"
                   type="text"
                   inputmode="numeric"
                   autocomplete="one-time-code"
                   maxlength="7"
                   required
                   autofocus
                   aria-describedby="akiba-otp-help" />

            <div class="akiba-otp-ring" aria-hidden="true">
                @for (var index = 0; index < 6; index++)
                {
                    <span class="akiba-otp-box" style="--i: @index"></span>
                }
            </div>

            <div class="akiba-otp-check" aria-hidden="true">
                <svg viewBox="0 0 72 72" fill="none" stroke="currentColor" stroke-width="3"
                     stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="36" cy="36" r="33" />
                    <path d="M23 37 L32 46 L50 27" />
                </svg>
            </div>
        </div>

        @* Read out as it changes: checking, accepted, or not accepted. *@
        <div class="akiba-otp-status" role="status" aria-live="polite" data-akiba-otp-status></div>

        <MudButton ButtonType="ButtonType.Submit"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Size="Size.Large">
            Continue
        </MudButton>
    </form>

    <MudLink Href="/sign-in" Typo="Typo.caption" Class="mt-5 d-block">
        Sign in as somebody else
    </MudLink>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }
}
