@page "/security/change-password"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Akiba – Change password</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Change password</MudText>

@if (Required)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        Your account was set up with a temporary password. Please choose a new one before continuing.
    </MudAlert>
}

@if (Error is not null)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@ErrorMessage</MudAlert>
}

<MudPaper Elevation="1" Class="pa-6" Style="max-width: 28rem;">
    <form method="post" action="/auth/change-password">
        <AntiforgeryToken />

        <MudTextField T="string"
                      Label="Current password"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      UserAttributes="@(new() { ["name"] = "currentPassword", ["autocomplete"] = "current-password", ["required"] = true, ["autofocus"] = true })"
                      Class="mb-3" />

        <MudTextField T="string"
                      Label="New password"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      UserAttributes="@(new() { ["name"] = "newPassword", ["autocomplete"] = "new-password", ["required"] = true })"
                      Class="mb-3" />

        <MudTextField T="string"
                      Label="Confirm new password"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      UserAttributes="@(new() { ["name"] = "confirmPassword", ["autocomplete"] = "new-password", ["required"] = true })"
                      Class="mb-5" />

        <MudButton ButtonType="ButtonType.Submit"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true">
            Change password
        </MudButton>
    </form>
</MudPaper>

<MudText Typo="Typo.body2" Class="mt-3 mud-text-secondary">
    Minimum 12 characters — must include an uppercase letter, a lowercase letter, a digit, and a symbol.
</MudText>

@code {
    [SupplyParameterFromQuery(Name = "required")]
    public bool Required { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private string ErrorMessage => Error switch
    {
        "mismatch" => "The new password and the confirmation do not match.",
        "invalid"  => "The current password is incorrect, or the new password does not meet the requirements.",
        "expired"  => "The page had been open too long. Try again.",
        _          => "Something went wrong. Try again.",
    };
}
