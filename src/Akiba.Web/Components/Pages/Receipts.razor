@page "/receipts"
@attribute [Authorize(Policy = AkibaPolicies.ViewsLedger)]
@inject IMediator Mediator
@inject IClock Clock

<PageTitle>Akiba - Receipts</PageTitle>

<PageHeader Title="Receipts"
            Description="Money in, on all three channels. A receipt reaches the ledger when it clears - a cheque that has not matured has not brought anything in.">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => _recording = true)">
            Record money in
        </MudButton>
    </Actions>
</PageHeader>

<RecordReceiptPanel @bind-Open="_recording" OnRecorded="ReloadAsync" />
<AllocateReceiptPanel @bind-Open="_allocating" Receipt="_working" OnAllocated="ReloadAsync" />

<WorkPanel @bind-Open="_clearing"
           Title="Mark a receipt as cleared"
           Subtitle="@_working?.Reference"
           Consequence="This is the entry that brings the money into the books. Until now the receipt was a note that something was coming."
           ConfirmText="It has cleared"
           ConfirmIcon="@Icons.Material.Filled.TaskAlt"
           CanConfirm="@(_clearedOn is not null)"
           Busy="_busy"
           Error="@_error"
           OnConfirm="ClearAsync">
    @if (_working is not null)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            <MoneyText Amount="_working.Amount" /> received on
            @_working.ReceivedOn.ToString("d MMMM yyyy", CultureInfo.InvariantCulture).
        </MudText>

        @* The date the bank cleared it, which is frequently not today - a clerk working
           through a statement is recording things that happened last week. *@
        <MudDatePicker @bind-Date="_clearedOn" Label="Cleared on"
                       DateFormat="dd MMM yyyy" Variant="Variant.Outlined" Margin="Margin.Dense"
                       HelperText="As the bank statement has it, not the day you are keying it" />
    }
</WorkPanel>

<MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true"
         ActivePanelIndexChanged="OnTabChanged">
    <MudTabPanel Text="Awaiting clearance" Icon="@Icons.Material.Filled.HourglassEmpty" />
    <MudTabPanel Text="Awaiting allocation" Icon="@Icons.Material.Filled.CallSplit" />
    <MudTabPanel Text="All" Icon="@Icons.Material.Filled.List" />
</MudTabs>

<MudPaper Elevation="1" Class="pa-2 mt-2">
    @if (_receipts is null)
    {
        <TableSkeleton Rows="8" Columns="6" />
    }
    else if (_receipts.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.Paid"
                    Title="@(_workList switch
                    {
                        ReceiptWorkList.AwaitingClearance => "Nothing is waiting to clear",
                        ReceiptWorkList.AwaitingAllocation => "Everything cleared has been allocated",
                        _ => "No receipts yet",
                    })"
                    Description="@(_workList switch
                    {
                        ReceiptWorkList.AwaitingClearance => "Every receipt the office knows about has reached the bank. On this queue that is the good answer.",
                        ReceiptWorkList.AwaitingAllocation => "Nobody is owed a decision. Every cleared shilling has been applied to a member, a loan or a refund.",
                        _ => "Money reaches Akiba as the payroll cheque, the landlord cheque, or a member paying in directly.",
                    })">
            @if (_workList == ReceiptWorkList.All)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@(() => _recording = true)">
                    Record the first one
                </MudButton>
            }
        </EmptyState>
    }
    else
    {
        <MudTable Items="_receipts" Dense="true" Hover="true" Striped="true" Elevation="0"
                  Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Received</MudTh>
                <MudTh>Channel</MudTh>
                <MudTh>Reference</MudTh>
                <MudTh>Name on slip</MudTh>
                <MudTh Style="text-align: right">Amount</MudTh>
                <MudTh Style="text-align: right">Unallocated</MudTh>
                <MudTh>Status</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Received">
                    @context.ReceivedOn.ToString("d MMM yyyy", CultureInfo.InvariantCulture)
                </MudTd>
                <MudTd DataLabel="Channel">
                    @ChannelLabel(context.Channel)
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                        @context.Method
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Reference">@context.Reference</MudTd>
                <MudTd DataLabel="Name on slip">
                    @if (string.IsNullOrWhiteSpace(context.PayerNameOnSlip))
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">-</MudText>
                    }
                    else
                    {
                        <MudTooltip Text="Kept exactly as written on the slip, not normalised to a member record">
                            <span>@context.PayerNameOnSlip</span>
                        </MudTooltip>
                    }
                </MudTd>
                <MudTd DataLabel="Amount" Class="akiba-money-cell">
                    <MoneyText Amount="context.Amount" />
                </MudTd>
                <MudTd DataLabel="Unallocated" Class="akiba-money-cell">
                    @if (context.IsFullyAllocated)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Allocated</MudText>
                    }
                    else
                    {
                        <MoneyText Amount="context.Unallocated" />
                    }
                </MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Color="@StatusColour(context.Status)">
                        @context.Status
                    </MudChip>
                    @if (context.ClearanceOverdue(_today))
                    {
                        <MudTooltip Text="@($"Expected to mature on {context.ExpectedClearanceOn:d MMM yyyy}")">
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Class="ml-1">
                                Overdue
                            </MudChip>
                        </MudTooltip>
                    }
                </MudTd>
                <MudTd Class="akiba-no-print">
                    <div class="akiba-row-actions">
                        @* Only the action this receipt is actually ready for. A receipt that
                           has not cleared cannot be allocated, and offering the button anyway
                           teaches an official that half the buttons here do nothing. *@
                        @if (!context.IsConfirmed)
                        {
                            <MudTooltip Text="Mark as cleared">
                                <MudIconButton Icon="@Icons.Material.Filled.TaskAlt"
                                               Size="Size.Small" Color="Color.Primary"
                                               aria-label="Mark as cleared"
                                               OnClick="@(() => StartClear(context))" />
                            </MudTooltip>
                        }
                        else if (!context.IsFullyAllocated)
                        {
                            <MudTooltip Text="Decide what it was for">
                                <MudIconButton Icon="@Icons.Material.Filled.CallSplit"
                                               Size="Size.Small" Color="Color.Warning"
                                               aria-label="Allocate"
                                               OnClick="@(() => StartAllocate(context))" />
                            </MudTooltip>
                        }
                    </div>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager Class="akiba-no-print" />
            </PagerContent>
        </MudTable>

        @if (_workList == ReceiptWorkList.AwaitingAllocation)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary pa-3 d-block">
                This queue is worked by hand. Allocation is never inferred - a wrong guess in a
                system of record is worse than no guess, because it looks like a decision
                somebody made.
            </MudText>
        }
    }
</MudPaper>

@code {
    private ReceiptWorkList _workList = ReceiptWorkList.AwaitingClearance;
    private IReadOnlyList<ReceiptSummary>? _receipts;
    private DateOnly _today;

    private bool _recording;
    private bool _allocating;
    private bool _clearing;
    private ReceiptSummary? _working;
    private DateTime? _clearedOn;
    private bool _busy;
    private string? _error;

    private void StartClear(ReceiptSummary receipt)
    {
        _working = receipt;
        _clearedOn = _today.ToDateTime(TimeOnly.MinValue);
        _error = null;
        _clearing = true;
    }

    private void StartAllocate(ReceiptSummary receipt)
    {
        _working = receipt;
        _error = null;
        _allocating = true;
    }

    private async Task ClearAsync()
    {
        if (_busy || _working is null || _clearedOn is not { } clearedOn)
        {
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            await Mediator.Send(new ClearReceiptCommand(
                _working.ReceiptId, DateOnly.FromDateTime(clearedOn)));

            _clearing = false;

            await ReloadAsync();
        }
        catch (Exception exception) when (exception is InvalidOperationException
            or ArgumentException or FluentValidation.ValidationException)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReloadAsync()
    {
        _receipts = null;

        await LoadAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        _today = Clock.TodayInNairobi;
        await LoadAsync();
    }

    private static string ChannelLabel(ReceiptChannel channel) => channel switch
    {
        ReceiptChannel.PayrollDeduction => "Payroll deduction",
        ReceiptChannel.LandlordRentOffset => "Landlord rent offset",
        _ => "Direct deposit",
    };

    private static Color StatusColour(ReceiptStatus status) => status switch
    {
        ReceiptStatus.Recorded => Color.Warning,
        ReceiptStatus.Cleared => Color.Info,
        ReceiptStatus.Reconciled => Color.Success,
        _ => Color.Default,
    };

    private async Task OnTabChanged(int index)
    {
        _workList = index switch
        {
            0 => ReceiptWorkList.AwaitingClearance,
            1 => ReceiptWorkList.AwaitingAllocation,
            _ => ReceiptWorkList.All,
        };

        _receipts = null;
        await LoadAsync();
    }

    private async Task LoadAsync() =>
        _receipts = await Mediator.Send(new ListReceiptsQuery(
            _workList, _today.AddYears(-2), _today.AddMonths(1)));
}
