@page "/sign-in"
@attribute [AllowAnonymous]
@layout SignInLayout
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Akiba - Sign in</PageTitle>

<div>
    @* The society's name is on the panel beside this, so it is not repeated here. What this
       needs is a heading that says which of the two steps you are on. *@
    <MudText Typo="Typo.h2" Class="mb-1">
        <h1 style="all: unset">Sign in</h1>
    </MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">
        Your account is one of five. There is no self sign-up.
    </MudText>

    @if (Error is not null)
    {
        <MudAlert Severity="@Tone" Dense="true" Class="mb-4">@ErrorMessage</MudAlert>
    }

    @* A plain form post. Signing in sets a cookie, and a Blazor circuit cannot - the response
       headers have gone by the time a component would handle the event. *@
    <form method="post" action="/auth/password">
        @* Proves this post came from Akiba's own page. Without it another site could
           post here and sign an official into an account somebody else controls. *@
        <AntiforgeryToken />

        <MudTextField T="string"
                      Label="User name"
                      InputType="InputType.Text"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      UserAttributes="@(new() { ["name"] = "userName", ["autocomplete"] = "username", ["required"] = true, ["autofocus"] = true })"
                      Class="mb-3" />

        <MudTextField T="string"
                      Label="Password"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      UserAttributes="@(new() { ["name"] = "password", ["autocomplete"] = "current-password", ["required"] = true })"
                      Class="mb-5" />

        <MudButton ButtonType="ButtonType.Submit"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Size="Size.Large">
            Sign in
        </MudButton>
    </form>

    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-6 d-block">
        Every account uses an authenticator app. After your password you will be asked for a
        six-digit code.
    </MudText>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private string ErrorMessage => Error switch
    {
        // Deliberately the same message for a wrong user name and a wrong password. Telling
        // somebody which one they got right narrows the guess, and there are only five accounts.
        "lockedout" =>
            "That account is locked for fifteen minutes after five failed attempts. " +
            "Wait, or ask the treasurer.",
        "expired" =>
            "That page had been open too long to be used. This is a fresh one - try again.",
        "signedout" => "You are signed out.",

        // Being cleared for being away is not a failure, and saying so in red teaches
        // officials to read every red bar on this screen as somebody getting it wrong.
        "timeout" =>
            "This screen was left for a few minutes, so Akiba signed you out and cleared it. "
            + "Anything you had already saved is saved.",
        _ => "That user name and password do not match.",
    };

    /// <summary>
    /// Red means somebody got something wrong.
    /// </summary>
    /// <remarks>
    /// Signing out and being cleared for being away are both the system working. Colouring
    /// them like a failure teaches officials that the red bar on this screen means nothing,
    /// and then the one that does mean something is not read either.
    /// </remarks>
    private Severity Tone => Error switch
    {
        "signedout" => Severity.Success,
        "timeout" or "expired" => Severity.Info,
        _ => Severity.Error,
    };
}
