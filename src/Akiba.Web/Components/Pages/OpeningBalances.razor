@page "/setup/opening-balances"
@attribute [Authorize(Policy = AkibaPolicies.LoadsOpeningBalances)]
@using System.Text.RegularExpressions
@using Akiba.Application.Migration
@inject IMediator Mediator
@inject IClock Clock
@inject IJSRuntime JS

@*
    Getting the society's existing register into Akiba, once.

    This is the only screen in the application that runs a handful of times and then never
    again, and it is the most dangerous one here: it is the moment a paper register of real
    people's savings becomes the opening position every future figure is derived from. A
    mistake made here is not a wrong screen, it is a wrong balance that compounds for years.

    So it is staged. Paste, check, then commit - and the commit is refused outright unless the
    check came back clean. The check is not a formality and cannot be skipped by an impatient
    treasurer, because the whole migration posts as one journal entry: it either happened or it
    did not, and there is no half-migrated state to unpick.

    Paste rather than upload, deliberately. The register is an Excel file containing every
    member's savings, and the office should not be putting a copy of it on a server to get it
    in here - nor should this application be storing one. Copying the columns out of Excel and
    pasting them leaves the file where it is.

    Column order (tabs or commas accepted):
      0  Staff Number
      1  Full Name
      2  Join Date                       (DD/MM/YYYY or YYYY-MM-DD; blank = unknown)
      3  Position Of Member              (free text; blank = none)
      4  Shareholding (KES)
      5  Share contribution (monthly)    (blank = not yet set)
      6  Emergency Loan Principal        (blank or 0 = none)
      7  Emergency Loan Start Date       (DD/MM/YYYY or YYYY-MM-DD)
      8  Emergency Loan Months Remaining
      9  Normal Loan Principal           (blank or 0 = none)
     10  Normal Loan Start Date
     11  Normal Loan Months Remaining
     12  Total Loan Deductions           (ignored — informational only)
*@

<PageTitle>Akiba - Opening balances</PageTitle>

<PageHeader Title="Opening balances"
            Description="The one-time load of the society's existing register. Everything Akiba reports afterwards is derived from what is entered here." />

@if (_result is not null)
{
    <MudAlert Severity="Severity.Success" Class="mb-4">
        <MudText Typo="Typo.subtitle2">The register is loaded.</MudText>
        <MudText Typo="Typo.body2">
            @_result.MembersCreated member(s) created carrying
            <MoneyText Amount="_result.TotalShareholding" /> of shareholding, with an opening
            bank balance of <MoneyText Amount="_result.OpeningBankBalance" />.
            @if (_result.LoansCreated > 0)
            {
                <text> @_result.LoansCreated loan(s) also carried in.</text>
            }
            It posted as one journal entry against Opening Balance Equity.
        </MudText>
        <MudText Typo="Typo.body2" Class="mt-2">
            <b>Do not run this again.</b> A second load would create every member twice.
        </MudText>
    </MudAlert>
}
else
{
    <MudPaper Elevation="1" Class="pa-4 mb-4">
        <MudText Typo="Typo.overline" Class="mud-text-secondary">Step one — the register</MudText>

        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2" Style="max-width: 70ch;">
            Download the template, fill it in Excel or Google Sheets — one member per row —
            then select all the data rows (not the heading), copy, and paste below.
            Loan columns are optional: leave them blank for members with no outstanding loans.
        </MudText>

        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Download"
                   Class="mb-4"
                   OnClick="DownloadTemplateAsync">
            Download template (akiba-members-template.csv)
        </MudButton>

        <MudTextField @bind-Value="_pasted" Label="Pasted from the register"
                      Lines="10" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Placeholder="0001&#9;Grace Njeri&#9;01/01/2020&#9;Chairperson&#9;102000&#9;2000&#9;&#9;&#9;&#9;50000&#9;15/06/2026&#9;6&#9;"
                      Class="akiba-paste" />

        <MudGrid Spacing="2" Class="mt-3">
            <MudItem xs="12" sm="6" md="4">
                <MudDatePicker @bind-Date="_goLive" Label="Go-live date"
                               DateFormat="dd MMM yyyy" Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               HelperText="The date every opening balance is dated" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudNumericField T="decimal" @bind-Value="_bankBalance"
                                 Label="Bank balance on that date (KES)"
                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Min="0" Format="N2" HideSpinButtons="true"
                                 HelperText="From the bank statement, not the cash book" />
            </MudItem>
            <MudItem xs="12" md="4" Class="d-flex align-start">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.FactCheck"
                           Disabled="@(_busy || string.IsNullOrWhiteSpace(_pasted))"
                           OnClick="CheckAsync">
                    Check it
                </MudButton>
            </MudItem>
        </MudGrid>

        @if (_parseProblems.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-3">
                <MudText Typo="Typo.subtitle2">
                    @_parseProblems.Count line(s) could not be read
                </MudText>
                @foreach (var problem in _parseProblems.Take(8))
                {
                    <MudText Typo="Typo.body2">@problem</MudText>
                }
                @if (_parseProblems.Count > 8)
                {
                    <MudText Typo="Typo.body2">
                        …and @(_parseProblems.Count - 8) more.
                    </MudText>
                }
            </MudAlert>
        }
    </MudPaper>

    @if (_dryRun is not null)
    {
        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.overline" Class="mud-text-secondary">
                Step two — what would happen
            </MudText>

            <MudGrid Spacing="3" Class="mt-1 mb-4">
                <MudItem xs="12" sm="4">
                    <div class="akiba-stat" style="color: var(--mud-palette-primary);">
                        <div class="akiba-stat-header">
                            <MudIcon Icon="@Icons.Material.Filled.Groups" Color="Color.Primary"
                                     Size="Size.Small" />
                            <MudText Typo="Typo.overline" Class="mud-text-secondary akiba-stat-title">
                                Members
                            </MudText>
                        </div>
                        <MudText Typo="Typo.h3" Class="akiba-figure">@_dryRun.Rows.Count</MudText>
                        <div class="akiba-stat-accent"></div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            would be created
                        </MudText>
                    </div>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <StatCard Title="Shareholding" Value="_dryRun.TotalShareholding"
                              Icon="@Icons.Material.Filled.Savings"
                              Caption="Total carried in"
                              Colour="Color.Tertiary" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <StatCard Title="Opening bank" Value="_dryRun.OpeningBankBalance"
                              Icon="@Icons.Material.Filled.AccountBalance"
                              Caption="As at the go-live date" />
                </MudItem>
                @if (_loanCount > 0)
                {
                    <MudItem xs="12" sm="4">
                        <div class="akiba-stat" style="color: var(--mud-palette-warning);">
                            <div class="akiba-stat-header">
                                <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet"
                                         Color="Color.Warning" Size="Size.Small" />
                                <MudText Typo="Typo.overline" Class="mud-text-secondary akiba-stat-title">
                                    Loans
                                </MudText>
                            </div>
                            <MudText Typo="Typo.h3" Class="akiba-figure">@_loanCount</MudText>
                            <div class="akiba-stat-accent"></div>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                would be carried in
                            </MudText>
                        </div>
                    </MudItem>
                }
            </MudGrid>

            @if (_dryRun.FatalProblems.Count > 0)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">
                    <MudText Typo="Typo.subtitle2">
                        This cannot be loaded until @_dryRun.FatalProblems.Count problem(s) are fixed.
                    </MudText>
                    <MudList T="string" Dense="true">
                        @foreach (var problem in _dryRun.FatalProblems)
                        {
                            <MudListItem T="string" Icon="@Icons.Material.Filled.Error"
                                         IconColor="Color.Error">
                                @(problem.RowNumber is { } row ? $"Line {row}: " : string.Empty)@problem.Problem
                            </MudListItem>
                        }
                    </MudList>
                </MudAlert>
            }

            @if (_dryRun.Warnings.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-4">
                    <MudText Typo="Typo.subtitle2">
                        @_dryRun.Warnings.Count thing(s) worth looking at first
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">
                        None of these stops the load. They are the rows somebody should check
                        against the paper register before committing to them for good.
                    </MudText>
                    <MudList T="string" Dense="true">
                        @foreach (var problem in _dryRun.Warnings)
                        {
                            <MudListItem T="string" Icon="@Icons.Material.Filled.Warning"
                                         IconColor="Color.Warning">
                                @(problem.RowNumber is { } row ? $"Line {row}: " : string.Empty)@problem.Problem
                            </MudListItem>
                        }
                    </MudList>
                </MudAlert>
            }

            <MudExpansionPanels Elevation="0" Class="mb-4">
                <MudExpansionPanel Text="@($"Read back all {_dryRun.Rows.Count} rows")">
                    <MudTable Items="_dryRun.Rows" Dense="true" Striped="true" Elevation="0"
                              Height="22rem" FixedHeader="true">
                        <HeaderContent>
                            <MudTh>Line</MudTh>
                            <MudTh>Staff no.</MudTh>
                            <MudTh>Name</MudTh>
                            <MudTh>Join date</MudTh>
                            <MudTh>Position</MudTh>
                            <MudTh Style="text-align: right">Shareholding</MudTh>
                            <MudTh Style="text-align: right">Monthly</MudTh>
                            <MudTh Style="text-align: right">Emerg. loan</MudTh>
                            <MudTh Style="text-align: right">Normal loan</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.RowNumber</MudTd>
                            <MudTd>@(context.StaffNumber ?? "—")</MudTd>
                            <MudTd>@context.Name</MudTd>
                            <MudTd>@(context.JoinDate.HasValue ? context.JoinDate.Value.ToString("d MMM yyyy") : "—")</MudTd>
                            <MudTd>@(context.PositionTitle ?? "—")</MudTd>
                            <MudTd Class="akiba-money-cell">
                                <MoneyText Amount="context.OpeningShareholding" />
                            </MudTd>
                            <MudTd Class="akiba-money-cell">
                                @if (context.MonthlyShareContribution is { } monthly)
                                {
                                    <MoneyText Amount="monthly" />
                                }
                                else
                                {
                                    <text>—</text>
                                }
                            </MudTd>
                            <MudTd Class="akiba-money-cell">
                                @if (context.EmergencyLoanPrincipal is { } el && el.IsPositive)
                                {
                                    <MoneyText Amount="el" />
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @context.EmergencyLoanMonths mo
                                    </MudText>
                                }
                                else
                                {
                                    <text>—</text>
                                }
                            </MudTd>
                            <MudTd Class="akiba-money-cell">
                                @if (context.NormalLoanPrincipal is { } nl && nl.IsPositive)
                                {
                                    <MoneyText Amount="nl" />
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @context.NormalLoanMonths mo
                                    </MudText>
                                }
                                else
                                {
                                    <text>—</text>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudExpansionPanel>
            </MudExpansionPanels>

            @if (_dryRun.FatalProblems.Count == 0)
            {
                <MudDivider Class="mb-4" />

                <MudText Typo="Typo.overline" Class="mud-text-secondary">
                    Step three — commit it
                </MudText>

                <MudAlert Severity="Severity.Warning" Class="my-3">
                    This runs once and cannot be undone. Every figure Akiba reports from now on
                    is derived from these balances. Check the totals against the paper register
                    before you sign.
                </MudAlert>

                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6">
                        <MudSelect T="ZoneId?" @bind-Value="_zoneId" Label="Zone for every member"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                   HelperText="Members are moved to their real zone afterwards">
                            @foreach (var zone in _zones)
                            {
                                <MudSelectItem T="ZoneId?" Value="@zone.Id">@zone.Label</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_treasurer" Label="Signed off by"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      HelperText="The treasurer's name. Recorded permanently." />
                    </MudItem>
                </MudGrid>

                <MudButton Variant="Variant.Filled" Color="Color.Error" Class="mt-3"
                           StartIcon="@Icons.Material.Filled.Publish"
                           Disabled="@(_busy || !CanCommit)"
                           OnClick="CommitAsync">
                    Load @_dryRun.Rows.Count member(s) permanently
                </MudButton>
            }
        </MudPaper>
    }
}

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
}

@code {
    private string? _pasted;
    private DateTime? _goLive;
    private decimal _bankBalance;
    private ZoneId? _zoneId;
    private string _treasurer = string.Empty;

    private IReadOnlyList<ZoneOption> _zones = [];
    private List<string> _parseProblems = [];
    private ImportDryRun? _dryRun;
    private ImportResult? _result;
    private int _loanCount;

    private bool _busy;
    private string? _error;

    /// <summary>
    /// A comma between a digit and exactly three more: a thousands separator, never a field.
    /// </summary>
    private static readonly Regex ThousandsSeparatorPattern =
        new(@"(?<=\d),(?=\d{3}(\D|$))", RegexOptions.Compiled);

    private static Regex ThousandsSeparator() => ThousandsSeparatorPattern;

    private bool CanCommit =>
        _dryRun is { FatalProblems.Count: 0 }
        && _zoneId is { } zone
        && zone.IsSpecified
        && !string.IsNullOrWhiteSpace(_treasurer);

    protected override async Task OnInitializedAsync()
    {
        _goLive = Clock.TodayInNairobi.ToDateTime(TimeOnly.MinValue);
        _zones = await Mediator.Send(new ListZonesQuery());
        _zoneId = (_zones.FirstOrDefault(zone => zone.IsOffice) ?? _zones.FirstOrDefault())?.Id;
    }

    /// <summary>
    /// Parses a date that may be DD/MM/YYYY, MM/DD/YYYY-ish, or ISO YYYY-MM-DD.
    /// Returns null when the cell is blank or unparseable.
    /// </summary>
    private static DateOnly? ParseDate(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return null;
        }

        // Try ISO first (least ambiguous).
        if (DateOnly.TryParseExact(raw, "yyyy-MM-dd",
                CultureInfo.InvariantCulture, DateTimeStyles.None, out var iso))
        {
            return iso;
        }

        // DD/MM/YYYY — the format on Kenyan forms and most East-African spreadsheets.
        if (DateOnly.TryParseExact(raw, "dd/MM/yyyy",
                CultureInfo.InvariantCulture, DateTimeStyles.None, out var dmy))
        {
            return dmy;
        }

        // Fallback: let the runtime try its best.
        if (DateOnly.TryParse(raw, CultureInfo.InvariantCulture, DateTimeStyles.None, out var fallback))
        {
            return fallback;
        }

        return null;
    }

    /// <summary>
    /// Strips KES, thousands separators, and whitespace, then tries to parse a decimal.
    /// Returns null when the cell is blank; returns the amount even when it is zero so the
    /// caller can decide whether zero is valid.
    /// </summary>
    private static decimal? ParseAmount(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return null;
        }

        var cleaned = raw
            .Replace("KES", string.Empty, StringComparison.OrdinalIgnoreCase)
            .Replace(",", string.Empty, StringComparison.Ordinal)
            .Trim();

        if (cleaned.Length == 0)
        {
            return null;
        }

        return decimal.TryParse(cleaned, NumberStyles.Number, CultureInfo.InvariantCulture, out var v)
            ? v
            : (decimal?)null;
    }

    /// <summary>
    /// Turns the pasted text into rows, tolerating tabs or commas as separators.
    /// Expects 5–13 columns; columns beyond 5 are the optional loan and contribution fields.
    /// </summary>
    private List<RegisterRow> Parse(string text)
    {
        var rows = new List<RegisterRow>();
        _parseProblems = [];

        var lines = text.Split('\n', StringSplitOptions.RemoveEmptyEntries);

        for (var index = 0; index < lines.Length; index++)
        {
            var line = lines[index].Trim('\r', ' ');

            if (string.IsNullOrWhiteSpace(line))
            {
                continue;
            }

            // Strip thousands separators before splitting so "45,000" does not become two fields.
            var normalised = ThousandsSeparator().Replace(line, string.Empty);

            var separators = normalised.Contains('\t', StringComparison.Ordinal)
                ? new[] { '\t' }
                : [','];

            var parts = normalised.Split(separators, StringSplitOptions.None)
                                  .Select(p => p.Trim())
                                  .ToArray();

            // Need at minimum: staff number, name, [join date, position,] shareholding.
            // The template has 13 columns; we accept anything from 3 upward and fill blanks.
            if (parts.Length < 3)
            {
                _parseProblems.Add($"Line {index + 1}: expected at least 3 columns, found {parts.Length}.");
                continue;
            }

            // Column layout when 13 columns are present:
            //  0  staff number
            //  1  full name
            //  2  join date
            //  3  position title
            //  4  shareholding
            //  5  monthly contribution
            //  6  emergency loan principal
            //  7  emergency loan start date
            //  8  emergency loan months
            //  9  normal loan principal
            // 10  normal loan start date
            // 11  normal loan months
            // 12  total loan deductions (ignored)
            //
            // When only 3 columns are present the old format (staff, name, shareholding) is
            // assumed for backward-compat.

            string staffNumberRaw, nameRaw, shareholdingRaw;
            string joinDateRaw = string.Empty, positionRaw = string.Empty;
            string monthlyRaw = string.Empty;
            string elPrincipalRaw = string.Empty, elDateRaw = string.Empty, elMonthsRaw = string.Empty;
            string nlPrincipalRaw = string.Empty, nlDateRaw = string.Empty, nlMonthsRaw = string.Empty;

            if (parts.Length >= 5)
            {
                // Full 13-column layout (or at least the first 5).
                staffNumberRaw   = parts[0];
                nameRaw          = parts[1];
                joinDateRaw      = parts[2];
                positionRaw      = parts[3];
                shareholdingRaw  = parts[4];
                monthlyRaw       = parts.Length > 5  ? parts[5]  : string.Empty;
                elPrincipalRaw   = parts.Length > 6  ? parts[6]  : string.Empty;
                elDateRaw        = parts.Length > 7  ? parts[7]  : string.Empty;
                elMonthsRaw      = parts.Length > 8  ? parts[8]  : string.Empty;
                nlPrincipalRaw   = parts.Length > 9  ? parts[9]  : string.Empty;
                nlDateRaw        = parts.Length > 10 ? parts[10] : string.Empty;
                nlMonthsRaw      = parts.Length > 11 ? parts[11] : string.Empty;
            }
            else
            {
                // Legacy 3-column format: staff number, name, shareholding.
                staffNumberRaw  = parts[0];
                nameRaw         = parts[1];
                shareholdingRaw = parts[2];
            }

            // --- Shareholding (required) ---
            var shareholdingDecimal = ParseAmount(shareholdingRaw);
            if (shareholdingDecimal is null)
            {
                // A heading row lands here — expected and harmless on line 1.
                if (index == 0)
                {
                    continue;
                }

                _parseProblems.Add($"Line {index + 1}: \"{shareholdingRaw}\" is not an amount.");
                continue;
            }

            if (string.IsNullOrWhiteSpace(nameRaw))
            {
                _parseProblems.Add($"Line {index + 1}: no name.");
                continue;
            }

            // --- Optional fields ---
            var joinDate      = ParseDate(joinDateRaw);
            var positionTitle = string.IsNullOrWhiteSpace(positionRaw) ? null : positionRaw;

            var monthlyDecimal = ParseAmount(monthlyRaw);
            Money? monthly = monthlyDecimal is { } m and > 0 ? Money.Kes(m) : null;

            var elPrincipalDecimal = ParseAmount(elPrincipalRaw);
            Money? elPrincipal = elPrincipalDecimal is { } el and > 0 ? Money.Kes(el) : null;
            var elDate   = ParseDate(elDateRaw);
            int? elMonths = int.TryParse(elMonthsRaw, out var em) && em > 0 ? em : null;

            var nlPrincipalDecimal = ParseAmount(nlPrincipalRaw);
            Money? nlPrincipal = nlPrincipalDecimal is { } nl and > 0 ? Money.Kes(nl) : null;
            var nlDate   = ParseDate(nlDateRaw);
            int? nlMonths = int.TryParse(nlMonthsRaw, out var nm) && nm > 0 ? nm : null;

            rows.Add(new RegisterRow(
                index + 1,
                string.IsNullOrWhiteSpace(staffNumberRaw) ? null : staffNumberRaw,
                nameRaw,
                joinDate,
                positionTitle,
                Money.Kes(shareholdingDecimal.Value),
                monthly,
                elPrincipal,
                elDate,
                elMonths,
                nlPrincipal,
                nlDate,
                nlMonths));
        }

        return rows;
    }

    private async Task CheckAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_pasted) || _goLive is not { } goLive)
        {
            return;
        }

        _busy = true;
        _error = null;
        _dryRun = null;

        try
        {
            var rows = Parse(_pasted);

            if (rows.Count == 0)
            {
                _error = "Nothing could be read from that. Check the columns match the template.";
                return;
            }

            _loanCount = rows.Count(r =>
                (r.EmergencyLoanPrincipal is { } el && el.IsPositive) ||
                (r.NormalLoanPrincipal    is { } nl && nl.IsPositive));

            _dryRun = await Mediator.Send(new DryRunOpeningBalancesCommand(
                rows, DateOnly.FromDateTime(goLive), Money.Kes(_bankBalance)));
        }
        catch (Exception exception) when (exception is InvalidOperationException
            or ArgumentException or FluentValidation.ValidationException)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DownloadTemplateAsync()
    {
        const string csv =
            "Staff Number,Full Name,Join Date,Position Of Member,Shareholding (KES)," +
            "Share contribution (monthly)," +
            "Emergency Loan (Principal Amount,Emergency Loan Start Date," +
            "Emergency Loan Number of months to be deducted," +
            "Normal Loan (Principal Amount,Normal Loan Start Date," +
            "Normal Loan Number of months to be deducted,Total Loan Deductions\r\n" +
            "0001,Grace Njeri,01/01/2020,Chairperson,102000,2000,,,,50000,15/06/2026,6,50000\r\n" +
            "0002,Peter Mwangi,15/03/2018,Secretary,93500,1500,25000,01/09/2026,3,,,, \r\n" +
            "0003,Jane Atieno,10/07/2021,,78000,2000,,,,,,,\r\n";

        var module = await JS.InvokeAsync<IJSObjectReference>(
            "import", "/js/akiba-download.js");
        await module.InvokeVoidAsync("downloadCsv", "akiba-members-template.csv", csv);
    }

    private async Task CommitAsync()
    {
        if (_busy || !CanCommit || _dryRun is null || _goLive is not { } goLive)
        {
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            _result = await Mediator.Send(new CommitOpeningBalancesCommand(
                _dryRun.Rows,
                DateOnly.FromDateTime(goLive),
                Money.Kes(_bankBalance),
                _zoneId!.Value,
                _treasurer.Trim()));

            _dryRun = null;
        }
        catch (Exception exception) when (exception is InvalidOperationException
            or ArgumentException or FluentValidation.ValidationException)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
