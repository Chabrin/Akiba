@page "/settings"
@attribute [Authorize(Policy = AkibaPolicies.ViewsLedger)]
@using Akiba.Application.Lending
@inject IMediator Mediator

<PageTitle>Akiba - Welfare Settings</PageTitle>

<PageHeader Title="Welfare Settings"
            Description="Member contribution amounts, loan products, and other society configuration.">
</PageHeader>

<ChangeContributionPanel @bind-Open="_changingContribution"
                         Member="_editingMember"
                         OnSaved="ReloadAsync" />

<ChangeLoanProductPanel @bind-Open="_editingLoanProduct"
                        Config="_editingConfig"
                        OnSaved="ReloadLoanProductsAsync" />

@* ── Contribution amounts ── *@
<MudPaper Elevation="1" Class="mb-6">
    <div class="pa-4 pb-0">
        <MudText Typo="Typo.h6">Monthly contribution amounts</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1 mb-3">
            The amount each <strong>employee</strong> member has instructed to be deducted from
            their salary each month. Set this from their enrolment letter; update it when they
            write to change it. Landlords are not listed here — they receive loans against rental
            income and have no monthly share deduction.
        </MudText>
    </div>

    <MudToolBar Dense="true" Class="akiba-list-toolbar px-4">
        <MudTextField T="string"
                      Value="_search"
                      ValueChanged="OnSearchChanged"
                      Placeholder="Search by name, membership or payroll number"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      Clearable="true"
                      Class="akiba-toolbar-search" />

        <MudSpacer />

        @if (UnsetCount > 0)
        {
            <MudTooltip Text="These members have no recorded instruction yet — the schedule will guess for them">
                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Class="ml-2">
                    @UnsetCount not set
                </MudChip>
            </MudTooltip>
        }
    </MudToolBar>

    @if (_contributions is null)
    {
        <TableSkeleton Rows="8" Columns="4" />
    }
    else if (Filtered.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.Savings"
                    Title="No members match that"
                    Description="Try a name or number." />
    }
    else
    {
        <MudTable Items="Filtered"
                  Dense="true"
                  Hover="true"
                  Striped="true"
                  Elevation="0"
                  Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Member</MudTh>
                <MudTh>Payroll no.</MudTh>
                <MudTh>Schedule</MudTh>
                <MudTh Style="text-align: right">Monthly contribution</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Member">
                    @context.Name
                    @if (!context.IsActive)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-2">
                            Left CAL
                        </MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Payroll no.">
                    @(string.IsNullOrWhiteSpace(context.PayrollNumber) ? "—" : context.PayrollNumber)
                </MudTd>
                <MudTd DataLabel="Schedule">
                    <BorrowerCategoryChip Category="context.Category" />
                </MudTd>
                <MudTd DataLabel="Monthly contribution" Class="akiba-money-cell">
                    @if (context.MonthlyContribution.HasValue)
                    {
                        <MoneyText Amount="context.MonthlyContribution.Value" />
                    }
                    else
                    {
                        <MudTooltip Text="Not set — the deduction schedule will infer from history until this is recorded">
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">Not set</MudChip>
                        </MudTooltip>
                    }
                </MudTd>
                <MudTd Class="akiba-no-print">
                    <div class="akiba-row-actions">
                        <MudTooltip Text="@(context.MonthlyContribution.HasValue ? "Change contribution amount" : "Set contribution amount")">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           Color="@(context.MonthlyContribution.HasValue ? Color.Default : Color.Warning)"
                                           aria-label="@($"Set contribution for {context.Name}")"
                                           OnClick="@(() => StartEdit(context))" />
                        </MudTooltip>
                    </div>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager Class="akiba-no-print" />
            </PagerContent>
        </MudTable>

        <MudText Typo="Typo.caption" Class="mud-text-secondary pa-3 d-block">
            @Filtered.Count of @_contributions.Count member(s).
            @if (UnsetCount > 0)
            {
                <span>
                    <strong>@UnsetCount</strong> have no recorded instruction — set these so the deduction schedule is exact.
                </span>
            }
        </MudText>
    }
</MudPaper>

@* ── Loan products ── *@
<MudPaper Elevation="1" Class="mb-6">
    <div class="pa-4">
        <MudText Typo="Typo.h6" Class="mb-1">Loan products</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            Rates and terms as approved by the committee. Use the edit button to record a change
            the committee has approved — enter the minute date as the effective from date.
        </MudText>

        @if (_loanProducts is null)
        {
            <MudProgressLinear Indeterminate="true" Class="mb-4" />
        }
        else
        {
            <MudGrid Spacing="3">
                @foreach (var product in _loanProducts)
                {
                    <MudItem xs="12" sm="6">
                        <MudPaper Outlined="true" Class="pa-4 d-flex flex-column" Style="height:100%">
                            <div class="d-flex align-center justify-space-between mb-2">
                                <MudText Typo="Typo.subtitle1">
                                    <MudIcon Icon="@ProductIcon(product.Product)" Size="Size.Small" Class="mr-1" />
                                    @product.ProductName
                                </MudText>
                                <MudTooltip Text="@($"Edit {product.ProductName} rate")">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Size="Size.Small"
                                                   Color="Color.Default"
                                                   aria-label="@($"Edit {product.ProductName}")"
                                                   OnClick="@(() => StartEditProduct(product))" />
                                </MudTooltip>
                            </div>

                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Interest</MudText>
                            @if (product.IsConfigured)
                            {
                                <MudText Class="mb-2">
                                    <strong>
                                        @if (product.RateIsMonthly)
                                        {
                                            @($"{product.InterestRate:P0} per month on principal")
                                        }
                                        else
                                        {
                                            @($"{product.InterestRate:P0} flat of principal, charged once")
                                        }
                                    </strong>
                                </MudText>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                                    Rate not yet approved by the committee
                                </MudAlert>
                            }

                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Principal limit</MudText>
                            <MudText Class="mb-2">
                                @if (product.MaxPrincipal.HasValue)
                                {
                                    <strong><MoneyText Amount="product.MaxPrincipal.Value" /></strong>
                                }
                                else
                                {
                                    <text>No fixed ceiling</text>
                                }
                            </MudText>

                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Repayment</MudText>
                            <MudText Class="mb-2">
                                @if (product.FixedTermMonths.HasValue)
                                {
                                    <strong>Fixed @product.FixedTermMonths months</strong>
                                }
                                else if (product.UsesGraduatedScale)
                                {
                                    <text>Graduated scale (see below)</text>
                                }
                                else if (product.MaximumTermMonths.HasValue)
                                {
                                    <text>Up to <strong>@product.MaximumTermMonths months</strong></text>
                                }
                                else
                                {
                                    <text>—</text>
                                }
                            </MudText>

                            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-auto">
                                Effective from @product.EffectiveFrom.ToShortDateString()
                            </MudText>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>

            @if (_termScale is not null && _termScale.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Graduated term scale</MudText>
                <MudSimpleTable Dense="true" Class="mb-2">
                    <thead>
                        <tr>
                            <th>Principal range (KES)</th>
                            <th style="text-align:right">Max months</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var band in _termScale)
                        {
                            <tr>
                                <td>
                                    @band.From.Amount.ToString("N0")
                                    @if (band.To.HasValue)
                                    {
                                        @($" – {band.To.Value.Amount:N0}")
                                    }
                                    else
                                    {
                                        @(" and above")
                                    }
                                </td>
                                <td style="text-align:right">@band.MaxTermMonths</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    The scale gives the <em>maximum</em>. A member may request a shorter term.
                    Loans below KES 30,000 have no defined term (open question 5).
                </MudText>
            }
        }

        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-3 d-block">
            Employee member loans: borrowing limit is twice shareholding; max two loans at once;
            guarantors required where outstanding balance exceeds the borrower's own shares;
            affordability checked at two-thirds of net pay.
            Landlord (rental income) loans are secured against rental income — the committee sets
            limits case by case, not by shareholding.
        </MudText>
    </div>
</MudPaper>

@* ── M-Pesa payments guide ── *@
<MudPaper Elevation="1" Class="mb-6">
    <div class="pa-4">
        <MudText Typo="Typo.h6" Class="mb-1">Recording M-Pesa payments</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            Members may pay directly via M-Pesa instead of waiting for the payroll deduction.
            Record these on the Receipts page using the steps below.
        </MudText>

        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6">
                <MudPaper Outlined="true" Class="pa-4">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Small" Class="mr-1" />
                        Share contribution (top-up)
                    </MudText>
                    <MudList T="string" Dense="true">
                        <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">
                            Record receipt → Direct deposit, M-Pesa
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">
                            Enter the M-Pesa code as the reference
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">
                            Identify the member from the payer name
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">
                            Allocate → <strong>Share Top-Up</strong>
                        </MudListItem>
                    </MudList>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
                        Share Top-Up appears on the member's statement separately from their regular
                        monthly contribution, so the two are always distinguishable.
                    </MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudPaper Outlined="true" Class="pa-4">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Payment" Size="Size.Small" Class="mr-1" />
                        Loan repayment (manual)
                    </MudText>
                    <MudList T="string" Dense="true">
                        <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">
                            Record receipt → Direct deposit, M-Pesa
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">
                            Enter the M-Pesa code as the reference
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">
                            Identify the member from the payer name
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">
                            Allocate → <strong>Loan Instalment</strong>, select the loan
                        </MudListItem>
                    </MudList>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
                        One receipt can cover both a share top-up and a loan repayment — allocate
                        it in two steps, one for each.
                    </MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </div>
</MudPaper>

@code {
    private IReadOnlyList<ContributionSetting>? _contributions;
    private IReadOnlyList<LoanProductConfig>? _loanProducts;
    private IReadOnlyList<TermScaleBandSetting>? _termScale;
    private string _search = string.Empty;
    private bool _changingContribution;
    private ContributionSetting? _editingMember;
    private bool _editingLoanProduct;
    private LoanProductConfig? _editingConfig;

    private IReadOnlyList<ContributionSetting> Filtered =>
        _contributions is null
            ? []
            : [.. _contributions
                .Where(m => string.IsNullOrWhiteSpace(_search) || Matches(m))];

    private int UnsetCount =>
        _contributions?.Count(m => !m.MonthlyContribution.HasValue && m.IsActive) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadAsync(), LoadLoanProductsAsync());
    }

    private bool Matches(ContributionSetting m) =>
        m.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || m.MembershipNumber.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || m.PayrollNumber.Contains(_search, StringComparison.OrdinalIgnoreCase);

    private void OnSearchChanged(string search) => _search = search ?? string.Empty;

    private async Task LoadAsync() =>
        _contributions = await Mediator.Send(new ListContributionSettingsQuery());

    private async Task LoadLoanProductsAsync()
    {
        var (products, scale) = await Mediator.Send(new ListLoanProductConfigsQuery());
        _loanProducts = products;
        _termScale = scale;
    }

    private async Task ReloadAsync()
    {
        _contributions = null;
        await LoadAsync();
    }

    private async Task ReloadLoanProductsAsync()
    {
        _loanProducts = null;
        _termScale = null;
        await LoadLoanProductsAsync();
    }

    private void StartEdit(ContributionSetting member)
    {
        _editingMember = member;
        _changingContribution = true;
    }

    private void StartEditProduct(LoanProductConfig config)
    {
        _editingConfig = config;
        _editingLoanProduct = true;
    }

    private static string ProductIcon(LoanProduct product) => product switch
    {
        LoanProduct.Emergency => Icons.Material.Filled.Emergency,
        LoanProduct.RentalIncome => Icons.Material.Filled.Home,
        LoanProduct.Client => Icons.Material.Filled.Person,
        _ => Icons.Material.Filled.RequestQuote,
    };
}
