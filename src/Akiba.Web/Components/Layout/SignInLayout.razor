@inherits LayoutComponentBase
@inject IWebHostEnvironment Environment

@* Private sign-in for officials. Keep the identity visible and the actual task immediate. *@

<MudThemeProvider Theme="AkibaTheme.Instance" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="akiba-signin">
    <aside class="akiba-signin-brand">
        <div class="akiba-signin-mark">
            <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Large" />

            <div>
                <div class="akiba-signin-name">Akiba</div>
                <div class="akiba-signin-sub">CAL Staff Welfare Society</div>
            </div>
        </div>

        <div class="akiba-signin-statement">
            <span class="akiba-signin-eyebrow">CAL Staff Welfare Society</span>
            <h2>Your society.<br />Clearly accounted.</h2>
            <p>Private access for authorised officials.</p>
        </div>

        <div class="akiba-signin-access">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
            <span>Secure staff workspace</span>
        </div>
    </aside>

    <main class="akiba-signin-form">
        @if (!Environment.IsProduction())
        {
            <div class="akiba-signin-environment" role="status">
                <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" />
                <span><b>@Environment.EnvironmentName</b> · Confirm the database before entering records.</span>
            </div>
        }
        <div class="akiba-signin-form-inner">
            @Body
        </div>
        <div class="akiba-signin-footer">Akiba · Staff welfare operations</div>
    </main>
</div>
