@*
    A page's title, what it is for, and whatever controls belong beside it.
*@

<div class="akiba-page-header">
    <div>
        <MudText Typo="Typo.h1" Class="mb-0">
            <h1 style="all: unset">@Title</h1>
        </MudText>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary akiba-page-description">
                @Description
            </MudText>
        }
    </div>

    @if (Actions is not null)
    {
        @* A row, not a block. Several pages put a date picker and a primary action side by
           side, and left to itself the picker's helper text pushes the button onto its own
           line - which reads as two unrelated controls rather than one set of page tools. *@
        <div class="akiba-page-actions akiba-no-print">@Actions</div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }
}
