@*
    One report on the reports screen: what it is, what comes out, what it will be run for, and
    the button that fetches it.

    Three things are on the card because each one saves a wasted download.

    The format decides what an official can do with the result. A schedule the office will sort
    and check against the register has to be a workbook; a statement a member receives has to be
    a PDF. Knowing which before clicking is the difference between opening a file and finding
    out it was the wrong shape.

    The parameter is the one the controls above are currently set to, written out in words. The
    commonest mistake on a screen like this is running the right report for the wrong month, and
    a date picker three inches away is not where somebody looks to check.

    The deadline, where there is one, is the reason the report exists at all.
*@

<div class="akiba-report" style="@AccentStyle">
    <div class="akiba-report-head">
        <MudIcon Icon="@Icon" Color="@Colour" Size="Size.Medium" />

        <div class="flex-grow-1 min-width-0">
            <MudText Typo="Typo.subtitle1">@Title</MudText>
        </div>

        <span class="akiba-format">@Format</span>
    </div>

    <MudText Typo="Typo.body2" Class="mud-text-secondary akiba-report-body">@Description</MudText>

    <div class="akiba-report-foot">
        @if (!string.IsNullOrWhiteSpace(Parameter))
        {
            <div class="akiba-report-parameter">
                <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Size="Size.Small" />
                <span>@Parameter</span>
            </div>
        }

        @if (Deadline is not null)
        {
            <MudChip T="string" Size="Size.Small" Color="@DeadlineColour"
                     Icon="@Icons.Material.Filled.Schedule" Class="ma-0">
                @Deadline
            </MudChip>
        }

        <MudSpacer />

        <MudButton Variant="Variant.Filled"
                   Color="@Colour"
                   Size="Size.Small"
                   StartIcon="@(IsDownload ? Icons.Material.Filled.Download : Icons.Material.Filled.ArrowForward)"
                   Href="@Href"
                   Target="@(IsDownload ? "_blank" : null)">
            @(LinkText ?? "Download")
        </MudButton>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Description { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Href { get; set; } = string.Empty;

    /// <summary>Excel, PDF or CSV. What actually comes out.</summary>
    [Parameter, EditorRequired] public string Format { get; set; } = string.Empty;

    /// <summary>What the controls above are currently set to, for this report.</summary>
    [Parameter] public string? Parameter { get; set; }

    /// <summary>When this is due, where it is due at all.</summary>
    [Parameter] public string? Deadline { get; set; }

    /// <summary>Whether the deadline has passed or is close.</summary>
    [Parameter] public Color DeadlineColour { get; set; } = Color.Default;

    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Description;

    /// <summary>The card's semantic colour, matching its section.</summary>
    [Parameter] public Color Colour { get; set; } = Color.Primary;

    /// <summary>Overrides the button's wording where it goes to a screen rather than a file.</summary>
    [Parameter] public string? LinkText { get; set; }

    private string AccentStyle =>
        $"--akiba-report-accent: var(--mud-palette-{Colour.ToString().ToLowerInvariant()});";

    /// <summary>
    /// Whether this fetches a file.
    /// </summary>
    /// <remarks>
    /// A report opens in a new tab so the panel keeps its place - a Blazor circuit navigated
    /// away from and back is a circuit that has to rebuild the page. A link to another screen
    /// stays in the same tab, because that is ordinary navigation.
    /// </remarks>
    private bool IsDownload => Href.StartsWith("/reports/", StringComparison.Ordinal);
}
