<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ================================================================
    Akiba.Infrastructure

    Everything that talks to the outside world: EF Core and PostgreSQL,
    repositories, ASP.NET Core Identity, email and SMS, file storage,
    Hangfire jobs, report writers.

    DEPENDENCY RULE: may reference Akiba.Application (and Akiba.Domain
    transitively). It must never reference Akiba.Web.
    ================================================================
  -->

  <PropertyGroup>
    <RootNamespace>Akiba.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!--
      Design-time only: this is what "dotnet ef migrations" runs on. PrivateAssets keeps it out
      of the published output, where a migration scaffolder has no business being.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Audit.NET" />
    <PackageReference Include="Audit.EntityFramework.Core" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="QuestPDF" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Akiba.Application\Akiba.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Repositories and the DbContext's row types are internal: outside this assembly, the only
      way to reach the database is through the ports in Akiba.Application. The integration
      tests construct the repositories directly, because testing them through a handler would
      be testing the handler.
    -->
    <InternalsVisibleTo Include="Akiba.Infrastructure.Tests" />
  </ItemGroup>

</Project>
