root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_size = 4

[*.{csproj,props,targets,json,yml,yaml,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Namespaces
csharp_style_namespace_declarations = file_scoped:error

# var
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Expression-bodied members
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion

# Modern C#
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_prefer_braces = true:warning
csharp_using_directive_placement = outside_namespace:error

# this.
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning

# Readonly where possible - aggregates must not expose mutable state
dotnet_style_readonly_field = true:warning

# Naming: private static readonly fields are PascalCase. Declared BEFORE the instance-field
# rule because the first matching rule wins, and a shared read-only value reads as a constant
# rather than as mutable state.
dotnet_naming_rule.private_static_readonly_pascal.severity = warning
dotnet_naming_rule.private_static_readonly_pascal.symbols = private_static_readonly_fields
dotnet_naming_rule.private_static_readonly_pascal.style = pascal_case_style
dotnet_naming_symbols.private_static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly_fields.required_modifiers = static,readonly
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# Naming: private instance fields _camelCase
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_prefix
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_prefix.required_prefix = _
dotnet_naming_style.underscore_prefix.capitalization = camel_case

# CA1062 (validate arguments) is noisy in a nullable-enabled codebase
dotnet_diagnostic.CA1062.severity = none
# CA1716 warns when a parameter name collides with a reserved word in ANOTHER .NET language,
# so that a VB or F# consumer can still implement the interface. Akiba is one C# solution with
# no external consumers, and `from`/`to`/`date` are the words an accountant uses for these
# things. Renaming them to placate a cross-language rule would cost clarity for no reader.
dotnet_diagnostic.CA1716.severity = none
# CA1848 (LoggerMessage delegates) and CA1873 (guard expensive log arguments) both optimise
# logging on a hot path. Akiba has four users on a LAN and logs at startup and at posting
# time; the source-generated delegates and IsEnabled guards would cost readability and buy
# nothing measurable.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none

[tests/**/*.cs]
# Test method names read as sentences: Disbursing_a_loan_posts_two_lines
dotnet_naming_rule.test_methods.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
# xUnit's collection-fixture convention is a type whose name ends in "Collection". CA1711
# reserves that suffix for ICollection implementations; here the framework's convention wins.
dotnet_diagnostic.CA1711.severity = none

# EF Core writes these files, not people. They are checked in because a migration is part of
# the schema's history and must never be regenerated differently, but they are not edited by
# hand, so holding them to the hand-written style rules only means reformatting generated code
# after every migration.
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1062.severity = none
