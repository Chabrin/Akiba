# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Database --------------------------------------------------------------
POSTGRES_DB=akiba
POSTGRES_USER=akiba
# Generate a long random value. This is the only credential guarding the ledger.
POSTGRES_PASSWORD=

# --- Network ---------------------------------------------------------------
# The LAN address of the dedicated Akiba machine, e.g. 192.168.1.40
# Leave as 127.0.0.1 to keep Akiba reachable only from the machine itself.
# Never set this to 0.0.0.0.
AKIBA_BIND_ADDRESS=127.0.0.1
AKIBA_PORT=8080

ASPNETCORE_ENVIRONMENT=Production

# --- Local diagnostics (not published to the LAN) --------------------------
POSTGRES_PORT=5432
SEQ_PORT=5341
