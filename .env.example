# Copy to .env for local development. .env is gitignored and must never be committed.
#
# In production these are set as environment variables on the Akiba service - see
# docs/deployment.md. Akiba reads standard .NET configuration, so any of appsettings.json,
# environment variables or user-secrets will do.

# The database. Akiba applies its own migrations at startup.
ConnectionStrings__Akiba=Host=localhost;Port=5432;Database=akiba;Username=akiba;Password=

# The address Akiba listens on.
#   127.0.0.1  reachable only from the machine itself - the safe default
#   the machine's LAN address, e.g. http://192.168.1.40:8080, to serve the four officials
# Never 0.0.0.0.
ASPNETCORE_URLS=http://127.0.0.1:8080

ASPNETCORE_ENVIRONMENT=Production
